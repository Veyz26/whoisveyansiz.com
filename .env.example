# Copy to .env.local for local dev. On Hostinger this is baked in at build time,
# so it must also be set in hPanel (or in the GitHub Action) before building.
#
# Where the contact form posts. Use a form-relay service so no personal email
# or phone number ends up in the public JS bundle.
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   Web3Forms:  https://api.web3forms.com/submit
# Leave unset and the form shows a "reach me on LinkedIn" notice instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=
